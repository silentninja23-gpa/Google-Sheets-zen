function updateZenDisplay() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Zen Sanctuary");
  if (!sheet) return;

  var props = PropertiesService.getDocumentProperties();
  var harmony = Math.max(0, parseInt(props.getProperty('Harmony') || '85'));
  var teas = props.getProperty('TeasBrewed') || '0';
  var gamesPlayed = props.getProperty('MiniGamesPlayed') || '0';
  var coins = props.getProperty('ZenCoins') || '50';
  var lastAction = props.getProperty('LastAction') || 'Ready.';

  sheet.getRange("D6:E6").merge().setValue(harmony + " / 100").setHorizontalAlignment("center").setBackground("#d4efdf");
  sheet.getRange("D7:E7").merge().setValue(teas).setHorizontalAlignment("center").setBackground("#d4efdf");
  sheet.getRange("D8:E8").merge().setValue(gamesPlayed).setHorizontalAlignment("center").setBackground("#d4efdf");
  sheet.getRange("D9:E9").merge().setValue(coins).setHorizontalAlignment("center").setBackground("#d4efdf");

  sheet.getRange("B23").setValue(lastAction);
  drawOasis(sheet);
}

function drawOasis(sheet) {
  var grid = [];
  for (let r = 0; r < 9; r++) {
    let row = [];
    for (let c = 0; c < 11; c++) {
      row.push(" ~ ");
    }
    grid.push(row);
  }

  var props = PropertiesService.getDocumentProperties();
  var items = props.getProperty('PurchasedItems') || "";

  grid[2][2] = items.indexOf("Bonsai") !== -1 ? " 🌲 " : " 🌸 ";
  grid[2][5] = " 🍵 ";
  grid[2][8] = items.indexOf("Fireplace") !== -1 ? " 🔥 " : " 🎋 ";
  grid[4][5] = items.indexOf("Diffuser") !== -1 ? " 💨 " : " 🪷 ";
  grid[6][2] = " 🪨 ";
  grid[6][8] = items.indexOf("Looper") !== -1 ? " 🎶 " : " 🍃 ";

  for (let r = 0; r < 9; r++) {
    for (let c = 0; c < 11; c++) {
      var cell = sheet.getRange(12 + r, 2 + c);
      cell.setValue(grid[r][c]);
      cell.setBackground("#e8f8f5").setFontColor("#117a65");
    }
  }

  sheet.getRange("B14").setValue("       ~ TRANQUIL OASIS ~       ");
  sheet.getRange("B15").setValue("Your sanctuary evolves as you buy shop upgrades.");
  sheet.getRange("B16").setValue("Select 'Open Calm Coin Shop' from the top menu bar!");
  sheet.getRange("B17").setValue("");
  sheet.getRange("B18").setValue("");
}

// --- CALM COIN SHOP ENGINE ---
function openCalmShop() {
  var ui = SpreadsheetApp.getUi();
  var props = PropertiesService.getDocumentProperties();
  var coins = parseInt(props.getProperty('ZenCoins') || '50');
  var purchased = props.getProperty('PurchasedItems') || "None";

  var shopChoice = ui.prompt(
    "🛍️ CALM COIN SHOP (You have " + coins + " Calm Coins)",
    "Items owned: " + purchased + "\n\n" +
    "Type the number of the item you want to buy:\n" +
    "1. 🌲 Mini Bonsai Tree (Cost: 30 coins) -> +5 Harmony\n" +
    "2. 🔥 Cozy Brick Fireplace (Cost: 40 coins) -> +8 Harmony\n" +
    "3. 💨 Aromatherapy Diffuser (Cost: 25 coins) -> +4 Harmony\n" +
    "4. 🎶 Lo-Fi Beats Looper (Cost: 50 coins) -> +12 Harmony",
    ui.ButtonSet.OK_CANCEL
  );

  if (shopChoice.getSelectedButton() == ui.Button.OK) {
    var choice = shopChoice.getResponseText().trim();
    var itemName = "";
    var cost = 0;
    var harmonyBoost = 0;

    if (choice === "1") {
      itemName = "Mini Bonsai Tree";
      cost = 30;
      harmonyBoost = 5;
    } else if (choice === "2") {
      itemName = "Cozy Brick Fireplace";
      cost = 40;
      harmonyBoost = 8;
    } else if (choice === "3") {
      itemName = "Aromatherapy Diffuser";
      cost = 25;
      harmonyBoost = 4;
    } else if (choice === "4") {
      itemName = "Lo-Fi Beats Looper";
      cost = 50;
      harmonyBoost = 12;
    } else {
      ui.alert("Invalid selection. Visit the shop anytime!");
      return;
    }

    if (coins >= cost) {
      coins -= cost;
      props.setProperty('ZenCoins', coins);
      
      var currentHarmony = parseInt(props.getProperty('Harmony') || '85');
      currentHarmony = Math.min(100, currentHarmony + harmonyBoost);
      props.setProperty('Harmony', currentHarmony);

      var currentItems = props.getProperty('PurchasedItems') || "";
      if (currentItems.indexOf(itemName) === -1) {
        props.setProperty('PurchasedItems', currentItems === "" ? itemName : currentItems + ", " + itemName);
      }

      props.setProperty('LastAction', "🛍️ Purchased " + itemName + "! Your harmony increased.");
      updateZenDisplay();
      ui.alert("🎉 Purchase Successful!", "You bought the " + itemName + "!", ui.ButtonSet.OK);
    } else {
      ui.alert("☕ Not enough Calm Coins!", "You need " + cost + " Calm Coins, but you only have " + coins + ".");
    }
  }
}

// --- INTERACTIVE SCRIPT MINI-GAME ENGINE ---
function playRandomInteractiveGame() {
  var randId = Math.floor(Math.random() * 100) + 1;
  runInteractiveMiniGame(randId);
}

function promptInteractiveGameNumber() {
  var ui = SpreadsheetApp.getUi();
  var response = ui.prompt('Play Interactive Cozy Game', 'Enter a mini-game number between 1 and 100:', ui.ButtonSet.OK_CANCEL);
  
  if (response.getSelectedButton() == ui.Button.OK) {
    var num = parseInt(response.getResponseText());
    if (num >= 1 && num <= 100) {
      runInteractiveMiniGame(num);
    } else {
      ui.alert('Please enter a valid number from 1 to 100.');
    }
  }
}

function runInteractiveMiniGame(id) {
  var ui = SpreadsheetApp.getUi();
  var categories = ["Puzzle & Logic", "Sensory & Ambient", "Creative & Craft", "Memory & Focus", "Idle & Relax"];
  var cat = categories[(id - 1) % categories.length];
  var name = getCozyGameName(id, cat);

  var result = false;
  var answered = false;
  
  if (cat === "Puzzle & Logic") {
    var guess = ui.prompt("🧩 " + name + " (#" + id + ")", 
      "Logic Puzzle: A gentle breeze shifts 3 smooth stones. If stone A is heavier than B, and B is heavier than C, which stone is lightest? (Type A, B, or C):", 
      ui.ButtonSet.OK_CANCEL);
    if (guess.getSelectedButton() == ui.Button.OK) {
      answered = true;
      if (guess.getResponseText().toUpperCase().trim() === "C") {
        result = true;
      }
    }
  } else if (cat === "Sensory & Ambient") {
    var guess = ui.prompt("🌧️ " + name + " (#" + id + ")", 
      "Sensory Focus: Listen closely to your breathing. How many seconds did your last inhale feel like? (Type a number, e.g., 4):", 
      ui.ButtonSet.OK_CANCEL);
    if (guess.getSelectedButton() == ui.Button.OK) {
      answered = true;
      result = true;
    }
  } else if (cat === "Creative & Craft") {
    var guess = ui.prompt("🎨 " + name + " (#" + id + ")", 
      "Creative Prompt: You are designing a serene ceramic vase. What color glaze do you choose? (Blue, Sage, Terracotta, or Gold):", 
      ui.ButtonSet.OK_CANCEL);
    if (guess.getSelectedButton() == ui.Button.OK) {
      answered = true;
      result = true;
    }
  } else if (cat === "Memory & Focus") {
    var targetNum = Math.floor(Math.random() * 5) + 3;
    var guess = ui.prompt("🧘 " + name + " (#" + id + ")", 
      "Focus Test: Quick! Imagine " + targetNum + " glowing fireflies in the garden. How many fireflies were there?", 
      ui.ButtonSet.OK_CANCEL);
    if (guess.getSelectedButton() == ui.Button.OK) {
      answered = true;
      if (parseInt(guess.getResponseText().trim()) === targetNum) {
        result = true;
      }
    }
  } else {
    var guess = ui.prompt("🛋️ " + name + " (#" + id + ")", 
      "Cozy Check-in: You take a moment to rest. Do you want to add 1 sugar or 2 to your warm cozy drink? (Type 1 or 2):", 
      ui.ButtonSet.OK_CANCEL);
    if (guess.getSelectedButton() == ui.Button.OK) {
      answered = true;
      result = true;
    }
  }

  if (!answered) return;

  var props = PropertiesService.getDocumentProperties();
  var played = parseInt(props.getProperty('MiniGamesPlayed') || '0') + 1;
  props.setProperty('MiniGamesPlayed', played);

  var currentHarmony = parseInt(props.getProperty('Harmony') || '85');

  if (result) {
    var coins = parseInt(props.getProperty('ZenCoins') || '50') + 25;
    props.setProperty('ZenCoins', coins);
    currentHarmony = Math.min(100, currentHarmony + 3);
    props.setProperty('Harmony', currentHarmony);
    props.setProperty('LastAction', "🎮 Completed Interactive Game #" + id + ": " + name + "! Success! (+25 Coins, +3 Harmony)");
    updateZenDisplay();
    ui.alert("🌟 Brilliant! Puzzle Solved!", "You completed " + name + " successfully.\n(+25 Calm Coins, +3 Harmony)", ui.ButtonSet.OK);
  } else {
    var coins = parseInt(props.getProperty('ZenCoins') || '50') + 5;
    props.setProperty('ZenCoins', coins);
    currentHarmony = Math.max(0, currentHarmony - 5);
    props.setProperty('Harmony', currentHarmony);
    props.setProperty('LastAction', "⚠️ Incorrect answer on Game #" + id + ": " + name + ". (-5 Harmony)");
    updateZenDisplay();
    ui.alert("🍃 Mind Unfocused...", "That wasn't quite right. Your inner harmony dipped slightly (-5 Harmony). Take a deep breath and try again!", ui.ButtonSet.OK);
  }
}

