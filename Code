function initZenGame() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Zen Sanctuary");
  
  if (!sheet) {
    sheet = ss.insertSheet("Zen Sanctuary");
  }
  sheet.clear();
  sheet.setTabColor("#27ae60");

  var props = PropertiesService.getDocumentProperties();
  props.setProperties({
    'Harmony': '85',
    'TeasBrewed': '3',
    'MiniGamesPlayed': '0',
    'ZenCoins': '50',
    'PurchasedItems': '',
    'LastAction': 'Welcome to your sanctuary. Stay mindful—mistakes slightly lower your harmony!'
  });

  buildZenDashboard(sheet);
  updateZenDisplay();
}

