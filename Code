function checkCrossword() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Cozy Crossword");
  
  if (!sheet) {
    SpreadsheetApp.getUi().alert("Please open the crossword first using the menu!");
    return;
  }

  var correct = true;
  var answers = {
    "B4": "P", "C4": "E", "D4": "A", "E4": "C", "F4": "E",
    "C5": "L",
    "B6": "T", "C6": "E", "D6": "A",
    "C7": "R",
    "C8": "M"
  };

  for (var cellRef in answers) {
    var val = sheet.getRange(cellRef).getValue().toString().toUpperCase().trim();
    if (val !== answers[cellRef]) {
      correct = false;
      sheet.getRange(cellRef).setBackground("#f5b7b1");
    } else {
      sheet.getRange(cellRef).setBackground("#d4efdf");
    }
  }

  var ui = SpreadsheetApp.getUi();
  var props = PropertiesService.getDocumentProperties();
  var currentHarmony = parseInt(props.getProperty('Harmony') || '85');

  if (correct) {
    var coins = parseInt(props.getProperty('ZenCoins') || '50') + 30;
    props.setProperty('ZenCoins', coins);
    currentHarmony = Math.min(100, currentHarmony + 5);
    props.setProperty('Harmony', currentHarmony);
    props.setProperty('LastAction', "🎉 Solved crossword puzzle correctly! (+30 Coins, +5 Harmony)");
    updateZenDisplay();
    ui.alert("🎉 Wonderful! All crossword answers are correct! (+30 Calm Coins, +5 Harmony)");
  } else {
    currentHarmony = Math.max(0, currentHarmony - 8);
    props.setProperty('Harmony', currentHarmony);
    props.setProperty('LastAction', "⚠️ Crossword check failed with errors. (-8 Harmony)");
    updateZenDisplay();
    ui.alert("⚠️ Some letters are incorrect (highlighted in red).\nYour inner focus wavered (-8 Harmony). Fix the red cells and check again!");
  }
}

